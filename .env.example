# Obtain this from @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token

# Use the value labelled "API Key (v3 auth)" in TMDb API settings. Never commit it.
TMDB_API_KEY=replace-with-your-tmdb-api-key

# Obtain this from OpenSubtitles API settings. Never commit it.
OPENSUBTITLES_API_KEY=replace-with-your-opensubtitles-api-key
OPENSUBTITLES_USERNAME=replace-with-your-opensubtitles-username
OPENSUBTITLES_PASSWORD=replace-with-your-opensubtitles-password

# PostgreSQL and Redis URLs may contain passwords. Keep them only in .env.
DATABASE_URL=postgresql://subtitle_bot:change-me@localhost:5432/subtitle_bot
REDIS_URL=redis://localhost:6379/0

# Brief cache expiry and conservative provider protection defaults.
TMDB_CACHE_TTL_SECONDS=300
SUBTITLE_CACHE_TTL_SECONDS=120
USER_SEARCH_LIMIT_PER_MINUTE=10
GLOBAL_TMDB_LIMIT_PER_MINUTE=120
GLOBAL_SUBTITLE_LIMIT_PER_MINUTE=60
USER_DOWNLOAD_LIMIT_PER_10_MINUTES=5
GLOBAL_DOWNLOAD_LIMIT_PER_MINUTE=20

# Liveness, readiness, and Prometheus-compatible metrics server.
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080
TELEGRAM_TASKS_CONCURRENCY_LIMIT=100

# Development, staging, or production.
APP_ENV=development
LOG_LEVEL=INFO
